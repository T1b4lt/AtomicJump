[internationalization]

locale/translations=PackedStringArray("res://localization/translations.es.translation", "res://localization/translations.en.translation")
locale/fallback="es"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="pickups"
2d_physics/layer_5="player_projectiles"
2d_physics/layer_6="enemy_projectiles"
2d_physics/layer_7="hazards"
2d_physics/layer_8="one_way_platforms"
2d_physics/layer_9="rising_threat"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
