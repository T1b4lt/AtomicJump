# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.gd]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Ficheros generados por el editor de Godot: se respeta su formato.
[*.{tscn,tres,godot,import,cfg,uid}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
